rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCalculationMethod(method) {
      return method in ['MOROCCO', 'MWL', 'UMM_AL_QURA', 'ISNA', 'EGYPT', 'KARACHI', 'DUBAI'];
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.language in ['ar', 'en'] &&
             data.themeMode in ['system', 'light', 'dark'] &&
             data.cityName is string && data.cityName.size() >= 1 && data.cityName.size() <= 100 &&
             data.latitude is number && data.latitude >= -90 && data.latitude <= 90 &&
             data.longitude is number && data.longitude >= -180 && data.longitude <= 180 &&
             isValidCalculationMethod(data.calculationMethod) &&
             data.quranFontSize is int && data.quranFontSize >= 16 && data.quranFontSize <= 40 &&
             data.lastSurahNumber is int && data.lastSurahNumber >= 1 && data.lastSurahNumber <= 114 &&
             data.lastAyahNumber is int && data.lastAyahNumber >= 1 && data.lastAyahNumber <= 286 &&
             data.lastSurahName is string && data.lastSurahName.size() <= 100 &&
             data.tasbihTotalCount is int && data.tasbihTotalCount >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidBookmark(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.itemType in ['QURAN', 'HADITH', 'DHIKR'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.subtitle is string && data.subtitle.size() <= 300 &&
             data.arabicText is string && data.arabicText.size() >= 1 && data.arabicText.size() <= 4000 &&
             data.referenceKey is string && data.referenceKey.size() >= 1 && data.referenceKey.size() <= 100 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAdhkarProgress(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 60 &&
             data.completedCount is int && data.completedCount >= 0 &&
             data.targetCount is int && data.targetCount >= 1 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'language', 'themeMode', 'cityName',
                         'latitude', 'longitude', 'calculationMethod', 'quranFontSize',
                         'lastSurahNumber', 'lastAyahNumber', 'lastSurahName',
                         'tasbihTotalCount', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'language', 'themeMode', 'cityName',
                         'latitude', 'longitude', 'calculationMethod', 'quranFontSize',
                         'lastSurahNumber', 'lastAyahNumber', 'lastSurahName',
                         'tasbihTotalCount', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'language', 'themeMode', 'cityName',
                         'latitude', 'longitude', 'calculationMethod', 'quranFontSize',
                         'lastSurahNumber', 'lastAyahNumber', 'lastSurahName',
                         'tasbihTotalCount', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /bookmarks/{bookmarkId} {
        allow get: if isOwner(userId) && isValidId(bookmarkId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(bookmarkId) &&
                         incoming().keys().hasAll([
                           'userId', 'itemType', 'title', 'subtitle',
                           'arabicText', 'referenceKey', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'itemType', 'title', 'subtitle',
                           'arabicText', 'referenceKey', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidBookmark(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(bookmarkId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidBookmark(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'subtitle', 'arabicText', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(bookmarkId);
      }

      match /adhkar_progress/{progressId} {
        allow get: if isOwner(userId) && isValidId(progressId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(progressId) &&
                         incoming().keys().hasAll([
                           'userId', 'categoryId', 'completedCount', 'targetCount',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'categoryId', 'completedCount', 'targetCount',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidAdhkarProgress(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(progressId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidAdhkarProgress(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'completedCount', 'targetCount', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(progressId);
      }
    }
  }
}
